# Variables d'environnement du backend (toutes facultatives en développement local).
# En production, définir au minimum RUNTODRAW_ALLOWED_ORIGINS avec l'adresse du site (ex. Vercel).

# Origines autorisées à appeler l'API (séparées par des virgules).
# RUNTODRAW_ALLOWED_ORIGINS=https://runtodraw.vercel.app

# Pour autoriser aussi les déploiements de prévisualisation Vercel (expression régulière) :
# RUNTODRAW_ALLOWED_ORIGIN_REGEX=https://runtodraw-.*\.vercel\.app

# Distance maximale d'un parcours, en km (défaut : 50).
# RUNTODRAW_MAX_DISTANCE_KM=50

# Requêtes coûteuses autorisées par minute et par adresse IP (défaut : 30, soit ~15 générations).
# RUNTODRAW_RATE_LIMIT_PER_MINUTE=30

# Calculs d'itinéraires simultanés (défaut : 2) et attente maximale avant « serveur occupé » (défaut : 60 s).
# RUNTODRAW_MAX_CONCURRENT_PLANS=2
# RUNTODRAW_QUEUE_TIMEOUT_S=60

# Graphes routiers gardés en mémoire (défaut : 3 ; mettre 2 sur l'offre gratuite de Render, 512 Mo).
# RUNTODRAW_GRAPH_CACHE_SIZE=3

# Niveau des journaux : DEBUG, INFO (défaut), WARNING.
# RUNTODRAW_LOG_LEVEL=INFO

# Nombre de proxys de confiance devant l'API pour lire l'adresse IP réelle (Render : 1, local : 0).
# RUNTODRAW_TRUSTED_PROXY_HOPS=1
