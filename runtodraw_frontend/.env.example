# Copier ce fichier en .env.local (non versionné) et renseigner les valeurs.

# Adresse du backend FastAPI (par défaut : http://localhost:8000)
# VITE_ROUTE_API_URL=http://localhost:8000

# Clé Geoapify pour la recherche d'adresses hors de France (gratuit : 3 000 requêtes/jour).
# Créer une clé sur https://myprojects.geoapify.com, puis limiter ses « origines autorisées »
# à l'adresse du site (et http://localhost:5173 en développement).
# Sans clé, l'appli utilise Photon : gratuit mais souvent très lent.
VITE_GEOAPIFY_KEY=
